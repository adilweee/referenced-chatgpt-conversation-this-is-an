rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{id} { allow read: if request.auth != null; allow create, update: if request.auth != null && request.auth.uid == id; }
    match /places/{id} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid; allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid; }
    match /memories/{id} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid; allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid; }
  }
}
